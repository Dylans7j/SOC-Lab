// Purpose: investigate repeated Windows failed-logon events.
// Status: documented query; validate field names against the active workspace schema.
// Primary event: Security Event ID 4625.

Event
| where EventID == 4625
| extend TargetUser = extract(@'<Data Name="TargetUserName">([^<]*)', 1, EventData)
| extend SourceIp = extract(@'<Data Name="IpAddress">([^<]*)', 1, EventData)
| extend LogonType = extract(@'<Data Name="LogonType">([^<]*)', 1, EventData)
| extend FailureReason = extract(@'<Data Name="FailureReason">([^<]*)', 1, EventData)
| summarize
    Attempts = count(),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated),
    Hosts = make_set(Computer, 20),
    LogonTypes = make_set(LogonType, 20),
    FailureReasons = make_set(FailureReason, 20)
  by SourceIp, TargetUser
| order by Attempts desc
